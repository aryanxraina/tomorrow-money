# ---- Cloud AI (pick one; leave empty to run without cloud AI) ----
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ---- On-device AI: QVAC `qvac serve openai` (or any OpenAI-compatible local server) ----
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=qwen3-600m

# ---- Location (optional): Google Places API (New) ----
GOOGLE_MAPS_API_KEY=

# ---- Share prices (optional): Finnhub free tier ----
FINNHUB_API_KEY=

# ---- Demo date: keeps forecasts reproducible. Remove to use today's date. ----
NEXT_PUBLIC_TODAY=2026-11-07
