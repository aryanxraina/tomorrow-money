# ---- Cloud AI (pick one; leave empty to run without cloud AI) ----
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ---- On-device AI: QVAC `qvac serve --openai -p 11435` (models are in qvac.config.json) ----
# Any OpenAI-compatible local server also works for text (Ollama: port 11434), but receipt OCR needs QVAC.
LOCAL_AI_BASE_URL=http://127.0.0.1:11435/v1
LOCAL_AI_MODEL=qwen3-4b
LOCAL_OCR_MODEL=ocr-en

# ---- Location (optional): Google Places API (New) ----
GOOGLE_MAPS_API_KEY=

# ---- Share prices (optional): Finnhub free tier ----
FINNHUB_API_KEY=

# ---- Demo date: keeps forecasts reproducible. Remove to use today's date. ----
NEXT_PUBLIC_TODAY=2026-11-07
