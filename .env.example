# Everything here is optional. With none of it, the app still works fully, using its own rules.

# ---- On-device AI, for computers: QVAC `qvac serve --openai -p 11435` (models are in qvac.config.json) ----
LOCAL_AI_BASE_URL=http://127.0.0.1:11435/v1
LOCAL_AI_MODEL=qwen3-4b
LOCAL_OCR_MODEL=ocr-en

# ---- Cloud AI: off unless a key is set ----
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-sonnet-5-5

# ---- Accounts: sign in with Google ----
# An OAuth 2.0 "Web application" client ID from Google Cloud. It's public by design (no secret is used).
# With it, people sign in with Google, their data is saved to a private file in their own Google Drive,
# and they can add bill reminders to their Google Calendar. Without it, the app works on this device only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Nearby: Google Places (New) API ----
# Lets the Nearby page list cash machines, Post Offices, food banks and advice centres near the person.
# Without it, Nearby shows links to the official finders only.
GOOGLE_PLACES_API_KEY=

# ---- Community Pulse: Reddit ----
# Works with no key (Reddit's public RSS feeds, collected slowly in the background).
# Optional official Data API (faster, adds upvotes): needs Reddit's approval, then a "script" app
# at https://www.reddit.com/prefs/apps.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Your Reddit username, added to the honest user agent Reddit asks for (optional).
REDDIT_USERNAME=
# Communities to search, comma-separated.
REDDIT_SUBREDDITS=UKPersonalFinance,UKFrugal
# Set to 1 to turn Reddit off (sample posts only).
REDDIT_DISABLED=

# ---- Community Pulse: YouTube and UK news (optional; each is off without its key) ----
# YouTube Data API v3 key (Google Cloud console). Free quota: 10,000 units a day; one collection uses about 910.
YOUTUBE_API_KEY=
# newsapi.org key. The free Developer plan is for development only (100 requests a day, last month only).
NEWS_API_KEY=
